// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String    @id @default(uuid())
  email                   String    @unique
  passwordHash            String?
  name                    String
  profilePicture          String?
  subscriptionPlan        String    @default("basic") // basic, elite, pro, admin
  subscriptionExpiresAt   DateTime?
  language                String    @default("en") // en, hi
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  // OAuth
  googleId                String?   @unique

  // Messaging
  telegramChatId          String?
  telegramConnected       Boolean   @default(false)
  whatsappNumber          String?
  whatsappConnected       Boolean   @default(false)

  // Preferences
  notificationPreferences Json      @default("{}")

  // Relations
  userAPI                 UserAPI?
  strategies              Strategy[]
  trades                  Trade[]
  riskSettings            RiskSettings?
  supportTickets          SupportTicket[]

  @@index([email])
  @@index([subscriptionPlan])
}

model AdminDataAPI {
  id            String   @id @default(uuid())
  apiKey        String   // encrypted
  apiSecret     String   // encrypted
  totpSecret    String   // encrypted
  loginId       String   // encrypted
  password      String   // encrypted
  isActive      Boolean  @default(true)
  lastUsed      DateTime @default(now())
  requestCount  Int      @default(0)
  createdAt     DateTime @default(now())

  @@index([isActive])
}

model UserAPI {
  id          String   @id @default(uuid())
  userId      String   @unique
  broker      String   @default("zerodha") // zerodha, upstox, dhan
  apiKey      String   // encrypted
  apiSecret   String   // encrypted
  totpSecret  String?  // encrypted
  loginId     String?  // encrypted
  password    String?  // encrypted
  isConnected Boolean  @default(false)
  lastLogin   DateTime @default(now())
  autoLogin   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Strategy {
  id              String   @id @default(uuid())
  userId          String
  name            String
  description     String
  category        String   // SCALPING, INTRADAY, SWING, INVESTMENT
  visibility      String   @default("PRIVATE") // PRIVATE, PUBLIC, INVITE_ONLY
  isAIGenerated   Boolean  @default(false)
  isActive        Boolean  @default(false)

  // Strategy Logic (stored as JSON)
  entryConditions Json
  exitConditions  Json
  stopLoss        Json
  target          Json
  trailingStopLoss Json?
  trailingTarget  Json?

  // Performance
  backtestResults Json?
  liveStats       Json?

  // Access Control
  invitedUsers    String[] @default([])

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  trades          Trade[]
  sharedWith      StrategyShare[]

  @@index([userId])
  @@index([visibility])
  @@index([category])
  @@index([isActive])
}

model StrategyShare {
  id          String   @id @default(uuid())
  strategyId  String
  userId      String
  grantedBy   String
  grantedAt   DateTime @default(now())
  revokedAt   DateTime?

  strategy    Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)

  @@unique([strategyId, userId])
  @@index([strategyId])
  @@index([userId])
}

model Trade {
  id              String   @id @default(uuid())
  userId          String
  strategyId      String
  instrument      String
  action          String   // buy, sell
  quantity        Int
  entryPrice      Float
  exitPrice       Float?
  stopLoss        Float
  target          Float
  status          String   @default("open") // open, closed, cancelled
  profitLoss      Float?
  mode            String   @default("paper") // live, paper

  // Broker details
  brokerOrderId   String?
  brokerTradeId   String?

  // Timestamps
  entryTime       DateTime @default(now())
  exitTime        DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  strategy        Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([strategyId])
  @@index([status])
  @@index([mode])
}

model RiskSettings {
  userId              String   @id
  aiTradingEnabled    Boolean  @default(false)
  dailyProfitLimit    Float
  dailyLossLimit      Float
  maxPositionSize     Float
  maxOpenPositions    Int
  allowedInstruments  String[]
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SupportTicket {
  id            String   @id @default(uuid())
  ticketNumber  String   @unique
  userId        String
  subject       String
  category      String   // technical, billing, feature_request, general
  priority      String   @default("medium") // low, medium, high
  status        String   @default("open") // open, in_progress, resolved, closed
  assignedTo    String?
  messages      Json     @default("[]")
  attachments   String[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  resolvedAt    DateTime?

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([ticketNumber])
}

model BlogPost {
  id              String   @id @default(uuid())
  slug            String   @unique
  title           String
  excerpt         String
  content         String
  author          String   // 'ai' or userId
  category        String   // education, strategy, analysis, tips
  tags            String[]
  featuredImage   String?
  language        String   @default("en") // en, hi

  // SEO
  metaTitle       String
  metaDescription String

  // Publishing
  status          String   @default("draft") // draft, published
  publishedAt     DateTime?

  // Engagement
  views           Int      @default(0)
  shares          Int      @default(0)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([slug])
  @@index([status])
  @@index([category])
}

model SocialPost {
  id                  String   @id @default(uuid())
  platform            String   // twitter, instagram, facebook
  content             String
  imageUrl            String?
  hashtags            String[]

  // Scheduling
  scheduledFor        DateTime
  status              String   @default("scheduled") // scheduled, posted, failed
  postedAt            DateTime?

  // Platform IDs
  twitterPostId       String?
  instagramPostId     String?
  facebookPostId      String?

  // Engagement
  likes               Int      @default(0)
  shares              Int      @default(0)
  comments            Int      @default(0)
  lastEngagementCheck DateTime @default(now())

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([platform])
  @@index([status])
  @@index([scheduledFor])
}

model UserAnalytics {
  id                  String   @id @default(uuid())
  userId              String
  date                DateTime @db.Date

  // Engagement
  sessionCount        Int      @default(0)
  sessionDuration     Int      @default(0)
  pagesViewed         Int      @default(0)

  // Trading
  tradesExecuted      Int      @default(0)
  profitLoss          Float    @default(0)
  strategiesActivated Int      @default(0)

  // Features Used
  strategiesCreated   Int      @default(0)
  backtestsRun        Int      @default(0)
  scannerUsed         Boolean  @default(false)
  aiAnalysisUsed      Boolean  @default(false)

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
}

model SystemMetrics {
  id                    String   @id @default(uuid())
  timestamp             DateTime @default(now())

  // Performance
  apiResponseTime       Float
  databaseQueryTime     Float
  tradingEngineLatency  Float

  // Resources
  cpuUsage              Float
  memoryUsage           Float
  databaseConnections   Int

  // Traffic
  activeUsers           Int
  requestsPerMinute     Int

  // Errors
  errorCount            Int
  errorRate             Float

  @@index([timestamp])
}

model Payment {
  id            String    @id @default(uuid())
  userId        String
  orderId       String    @unique
  paymentId     String?
  signature     String?
  amount        Float
  currency      String    @default("INR")
  status        String    @default("created") // created, success, failed, refunded
  planId        String
  receipt       String
  errorMessage  String?
  refundId      String?
  createdAt     DateTime  @default(now())
  paidAt        DateTime?
  refundedAt    DateTime?

  @@index([userId])
  @@index([status])
  @@index([orderId])
}
